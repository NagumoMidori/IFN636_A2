{
	"info": {
		"name": "Explore Australia API",
		"description": "Complete API collection for the Explore Australia web application. Covers Authentication, User Profile, Tours, Cart, Orders, and Reviews.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "userToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "tourId",
			"value": "",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "",
			"type": "string"
		},
		{
			"key": "reviewId",
			"value": "",
			"type": "string"
		},
		{
			"key": "cartItemId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"]}
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('userToken', jsonData.token);"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
					}
				},
				{
					"name": "Register Admin",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"adminuser\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"]}
					}
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('adminToken', jsonData.token);"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
					}
				}
			]
		},
		{
			"name": "2. User Profile",
			"item": [
				{
					"name": "Get Auth Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"]}
					}
				},
				{
					"name": "Update Auth Profile",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"updateduser\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"]}
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"]}
					}
				},
				{
					"name": "Update User Profile",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"0400000000\",\n  \"address\": \"123 Test Street, Brisbane\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"]}
					}
				},
				{
					"name": "Admin: Get All Users",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"]}
					}
				},
				{
					"name": "Admin: Get User By ID",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/users/:id", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"]}
					}
				}
			]
		},
		{
			"name": "3. Tours",
			"item": [
				{
					"name": "Get All Tours",
					"request": {
						"method": "GET",
						"url": {"raw": "{{baseUrl}}/api/tours", "host": ["{{baseUrl}}"], "path": ["api", "tours"]}
					}
				},
				{
					"name": "Search Tours by Keyword",
					"request": {
						"method": "GET",
						"url": {"raw": "{{baseUrl}}/api/tours?search=Sydney", "host": ["{{baseUrl}}"], "path": ["api", "tours"], "query": [{"key": "search", "value": "Sydney"}]}
					}
				},
				{
					"name": "Get Tour By ID",
					"request": {
						"method": "GET",
						"url": {"raw": "{{baseUrl}}/api/tours/{{tourId}}", "host": ["{{baseUrl}}"], "path": ["api", "tours", "{{tourId}}"]}
					}
				},
				{
					"name": "Admin: Create Tour",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('tourId', jsonData._id);"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Sydney Harbour Cruise\",\n  \"location\": \"Sydney\",\n  \"description\": \"A scenic cruise around Sydney Harbour.\",\n  \"price\": 150,\n  \"originalPrice\": 200,\n  \"imageUrl\": \"/images/sydney.webp\",\n  \"type\": \"day\",\n  \"status\": \"Available\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/tours", "host": ["{{baseUrl}}"], "path": ["api", "tours"]}
					}
				},
				{
					"name": "Admin: Update Tour",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Sydney Harbour Cruise (Updated)\",\n  \"price\": 180\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/tours/{{tourId}}", "host": ["{{baseUrl}}"], "path": ["api", "tours", "{{tourId}}"]}
					}
				},
				{
					"name": "Admin: Delete Tour",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/tours/{{tourId}}", "host": ["{{baseUrl}}"], "path": ["api", "tours", "{{tourId}}"]}
					}
				}
			]
		},
		{
			"name": "4. Cart",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"]}
					}
				},
				{
					"name": "Add Tour to Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var jsonData = pm.response.json();", "if (jsonData.items && jsonData.items.length > 0) { pm.collectionVariables.set('cartItemId', jsonData.items[0]._id); }"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tourId\": \"{{tourId}}\",\n  \"quantity\": 2,\n  \"tourDate\": \"2026-07-01\",\n  \"personalInfo\": {\n    \"fullName\": \"Test User\",\n    \"phone\": \"0400000001\"\n  }\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/cart/add", "host": ["{{baseUrl}}"], "path": ["api", "cart", "add"]}
					}
				},
				{
					"name": "Update Cart Item",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cartItemId\": \"{{cartItemId}}\",\n  \"quantity\": 3\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/cart/update", "host": ["{{baseUrl}}"], "path": ["api", "cart", "update"]}
					}
				},
				{
					"name": "Remove Cart Item",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/cart/{{cartItemId}}", "host": ["{{baseUrl}}"], "path": ["api", "cart", "{{cartItemId}}"]}
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"]}
					}
				}
			]
		},
		{
			"name": "5. Orders",
			"item": [
				{
					"name": "Create Order (Checkout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('orderId', jsonData._id);"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"totalAmount\": 1\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"]}
					}
				},
				{
					"name": "Get My Orders",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/orders/my", "host": ["{{baseUrl}}"], "path": ["api", "orders", "my"]}
					}
				},
				{
					"name": "Get Order By ID",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"]}
					}
				},
				{
					"name": "Admin: Get All Orders",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/orders/all", "host": ["{{baseUrl}}"], "path": ["api", "orders", "all"]}
					}
				},
				{
					"name": "Admin: Update Order Status",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Confirmed\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "status"]}
					}
				}
			]
		},
		{
			"name": "6. Reviews",
			"item": [
				{
					"name": "Create Review",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": ["var jsonData = pm.response.json();", "pm.collectionVariables.set('reviewId', jsonData._id);"],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tour\": \"{{tourId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excellent tour experience!\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"]}
					}
				},
				{
					"name": "Get Reviews for Tour",
					"request": {
						"method": "GET",
						"url": {"raw": "{{baseUrl}}/api/reviews/tour/{{tourId}}", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "tour", "{{tourId}}"]}
					}
				},
				{
					"name": "Get My Review for Tour",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"url": {"raw": "{{baseUrl}}/api/reviews/my/{{tourId}}", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "my", "{{tourId}}"]}
					}
				},
				{
					"name": "Update Review",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{userToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 4,\n  \"comment\": \"Updated review comment.\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/reviews/{{reviewId}}", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "{{reviewId}}"]}
					}
				},
				{
					"name": "Admin: Update Review Status",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{adminToken}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Hidden\"\n}"
						},
						"url": {"raw": "{{baseUrl}}/api/reviews/{{reviewId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "{{reviewId}}", "status"]}
					}
				}
			]
		}
	]
}
